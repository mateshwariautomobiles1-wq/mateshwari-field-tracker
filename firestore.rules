rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ YAHAN APNA ADMIN EMAIL DAALEIN (jo Firebase Authentication me banaya hai)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['mateshwariautomobiles1@gmail.com'];
    }

    function hasSession() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid));
    }

    // Ye phone (anonymous login) isi mobile number ke employee ka hai?
    function isEmp(m) {
      return hasSession()
        && get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.mobile == m;
    }

    function isActiveEmp(m) {
      return isEmp(m)
        && get(/databases/$(database)/documents/employees/$(m)).data.active == true;
    }

    // logins/{mobile}_{pin} — sirf admin likhta hai; app sirf rule ke andar check karta hai
    match /logins/{key} {
      allow read, write: if isAdmin();
    }

    // Phone login: sahi mobile + PIN ho tabhi session banega
    match /sessions/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.mobile is string
        && request.resource.data.pin is string
        && exists(/databases/$(database)/documents/logins/$(request.resource.data.mobile + '_' + request.resource.data.pin));
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /employees/{m} {
      allow read, write: if isAdmin();
      allow get: if isEmp(m);

      match /locations/{id} {
        allow read, delete: if isAdmin();
        allow create: if isActiveEmp(m)
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.t is timestamp;
      }
    }

    match /live/{m} {
      allow read, write: if isAdmin();
      allow create, update: if isActiveEmp(m);
    }
  }
}
